{
    "Constants": {
        "STACK_START": "0x100",
        "SP": "0",
        "ARGS": "1",
        "LOCALS": "2",
        "RETVAL": "6",
        "TMP": "3"
    },
    "Macros": {
        "INIT_STACK": {
            "leaf": true,
            "code": "A = STACK_START\nD = A\nA = SP\n*A = D"
        },
        "PUSH_D": {
            "leaf": true,
            "code": "A = SP\n*A = *A\n*A = *A+1\nA = *A-1\n*A = D"
        },
        "POP_D": {
            "leaf": true,
            "code": "A = SP\nA, *A = *A-1\nD = *A"
        },
        "POP_A": {
            "leaf": true,
            "code": "A = SP\nA, *A = *A-1\nA = *A"
        },
        "PUSH_VALUE": {
            "placeholders": [ "value" ],
            "leaf": false,
            "code": "A = value\nD = A\nPUSH_D"
        },
        "ADD": {
            "leaf": false,
            "code": "POP_D\nA = A-1\n*A = D+*A"
        },
        "SUB": {
            "leaf": false,
            "code": "POP_D\nPOP_A\nD = A-D\nPUSH_D"
        },
        "NEG": {
            "leaf": true,
            "code": "A = SP\nA = *A-1\n*A = -*A"
        },
        "AND": {
            "leaf": false,
            "code": "POP_D\nPOP_A\nD = D&A\nPUSH_D"
        },
        "OR": {
            "leaf": false,
            "code": "POP_D\nPOP_A\nD = D|A\nPUSH_D"
        },
        "EQ": {
            "labels": [ "end", "eq", "neq" ],
            "leaf": false,
            "code": "POP_D\nPOP_A\nD = A - D\nA = eq\nD;JEQ\nneq:\nPUSH_VALUE 0\nA = end\nJMP\neq:\nD = 0\nD = ~D\nPUSH_D\nend:"
        },
        "GT": {
            "labels": [ "end", "eq", "neq" ],
            "leaf": false,
            "code": "POP_D\nPOP_A\nD = A - D\nA = eq\nD;JGT\nneq:\nPUSH_VALUE 0\nA = end\nJMP\neq:\nD = 0\nD = ~D\nPUSH_D\nend:"
        },
        "LT": {
            "labels": [ "end", "eq", "neq" ],
            "leaf": false,
            "code": "POP_D\nPOP_A\nD = A - D\nA = eq\nD;JLT\nneq:\nPUSH_VALUE 0\nA = end\nJMP\neq:\nD = 0\nD = ~D\nPUSH_D\nend:"
        },
        "NOT": {
            "leaf": true,
            "code": "A = SP\nA = *A-1\n*A = ~*A"
        },
        "GOTO": {
            "placeholders": [ "label" ],
            "leaf": true,
            "code": "A = label\nJMP"
        },
        "IF_GOTO": {
            "placeholders": [ "label" ],
            "leaf": false,
            "code": "POP_D\nA = label\nD;JNE"
        },
        "PUSH_MEMORY": {
            "leaf": false,
            "code": "POP_A\nD = *A\nPUSH_D"
        },
        "POP_MEMORY": {
            "leaf": false,
            "code": "POP_D\nPOP_A\n*A = D"
        },
        "PUSH_STATIC": {
            "placeholders": [ "address" ],
            "leaf": false,
            "code": "A = address\nD = *A\nPUSH_D"
        },
        "POP_STATIC": {
            "placeholders": [ "address" ],
            "leaf": false,
            "code": "POP_D\nA = address\n*A = D"
        },
        "CALL": {
            "placeholders": [ "functionName", "argumentCount" ],
            "labels": [ "RETLAB" ],
            "leaf": false,
            "code": "PUSH_STATIC ARGS\nPUSH_STATIC LOCALS\nPUSH_VALUE RETLAB\nPUSH_STATIC SP\nPUSH_VALUE argumentCount\nSUB\nPUSH_VALUE 3\nSUB\nPOP_STATIC ARGS\nGOTO functionName\nRETLAB:\nPUSH_STATIC ARGS\nPOP_STATIC TMP\nPOP_STATIC LOCALS\nPOP_STATIC ARGS\nPUSH_STATIC TMP\nPOP_STATIC SP\nPUSH_STATIC RETVAL"
        },
        "FUNCTION": {
            "placeholders": [ "functionName", "localsCount" ],
            "leaf": false,
            "code": "functionName:\nPUSH_STATIC SP\nPOP_STATIC LOCALS\nPUSH_STATIC SP\nPUSH_VALUE localsCount\nADD\nPOP_STATIC SP"
        },
        "RETURN": {
            "placeholders": [],
            "leaf": false,
            "code": "POP_STATIC RETVAL\nPUSH_STATIC LOCALS\nPOP_STATIC SP\nPOP_A\nJMP"
        },
        "PUSH_ARG": {
            "placeholders": [ "index" ],
            "leaf": false,
            "code": "PUSH_STATIC ARGS\nPUSH_VALUE index\nADD\nPUSH_MEMORY"
        },
        "POP_ARG": {
            "placeholders": [ "index" ],
            "leaf": false,
            "code": "POP_STATIC TMP\nPUSH_STATIC ARGS\nPUSH_VALUE index\nADD\nPUSH_STATIC TMP\nPOP_MEMORY"
        },
        "PUSH_LOCAL": {
            "placeholders": [ "index" ],
            "leaf": false,
            "code": "PUSH_STATIC LOCALS\nPUSH_VALUE index\nADD\nPUSH_MEMORY"
        },
        "POP_LOCAL": {
            "placeholders": [ "index" ],
            "leaf": false,
            "code": "POP_STATIC TMP\nPUSH_STATIC LOCALS\nPUSH_VALUE index\nADD\nPUSH_STATIC TMP\nPOP_MEMORY"
        },
        // NOT REAL REMOVE
        "GOTOX": {
            "placeholders": [ "arg1" ],
            "leaf": false,
            "code": "GOTO arg1"
        },
        // NOT REAL REMOVE
        "CALLX": {
            "placeholders": [ "index" ],
            "labels": [ "othersp" ],
            "leaf": false,
            "code": "othersp:\nA = TMP\nA = 1\nD = index\nGOTOX othersp"
        }
    }
}